  "loss": "importance_sampling_weighted_MSE",
  "optimizer": "Adam",
  "state_transition": "sequential_training_data",
  "architecture": {
    "type": "dueling_dqn",
    "feature_layers": [
      64,
      64
    ],
    "value_stream": [
      64,
      1
    ],
    "advantage_stream": [
      64,
      2
    ]
  },
  "target_rule": "double_dqn",
